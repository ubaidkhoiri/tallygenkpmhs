# Contoh env. Salin ke .env lalu isi nilai asli. Jangan commit .env.
# Copy to .env and fill real values. Never commit .env.

# Tally API key, dari dashboard Tally milikmu
TALLY_API_KEY=

# ID internal form Tally, konfirmasi via Tally API. Bukan ID pendek URL publik.
TALLY_FORM_ID=

# Secret untuk verifikasi signature webhook Tally
TALLY_SIGNING_SECRET=

# Satu password bersama untuk akses MOD
MOD_PASSWORD=

# Connection string Neon Postgres
DATABASE_URL=
